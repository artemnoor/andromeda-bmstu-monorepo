# Copy to .env and replace every placeholder with local-only values.
# Never put production credentials or production database URLs here.
ACADEMIC_DATA_ENV=test
ACADEMIC_DATA_DATABASE_URL=postgresql+psycopg://andromeda_test:local-only-change-me@127.0.0.1:55433/academic_data_test
ANDROMEDA_DB_PORT=55433
POSTGRES_DB=academic_data_test
POSTGRES_USER=andromeda_test
POSTGRES_PASSWORD=local-only-change-me

# Required only for `docker compose --profile directus ...` and `make directus`.
DIRECTUS_SECRET=REPLACE_ME
ANDROMEDA_DIRECTUS_DB_PASSWORD=REPLACE_ME
DIRECTUS_ADMIN_EMAIL=team@example.invalid
DIRECTUS_ADMIN_PASSWORD=REPLACE_ME
DIRECTUS_PORT=8055
DIRECTUS_TEST_URL=http://127.0.0.1:8055
DIRECTUS_LICENSE_KEY=
LOG_LEVEL=debug
