# Public numeric site ID from our own Rybbit instance. No API key required.
VITE_ANALYTICS_SITE_ID=
# Local development is excluded unless explicitly enabled.
VITE_ANALYTICS_DEBUG=false

# Build-time API origin for prerendering the real catalog; never embedded in browser requests.
# Defaults to https://andromedabmstu.ru. Use the VM IP or a local API during deployment.
SEO_API_ORIGIN=https://andromedabmstu.ru
