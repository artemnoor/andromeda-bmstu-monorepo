{
  "name": "andromeda-web-react-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 4180",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1 --port 4181 --strictPort",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:profile": "node scripts/run-profile.mjs",
    "test:visual": "node scripts/run-paired-qa.mjs visual",
    "test:paired": "node scripts/run-paired-qa.mjs all",
    "api:generate": "uv run --package andromeda-api python scripts/export_openapi.py && openapi-typescript openapi.json --output src/shared/api/schema.d.ts",
    "api:check": "uv run --package andromeda-api python scripts/export_openapi.py --check && openapi-typescript openapi.json --output src/shared/api/schema.d.ts --check",
    "test:benchmark": "node scripts/run-paired-qa.mjs benchmark"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "isbot": "^5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.14",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
